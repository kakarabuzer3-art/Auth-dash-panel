{
  "name": "autodash-control-panel",
  "version": "1.0.0",
  "description": "AI-Powered Desktop Automation Dashboard",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect=5858",
    "build": "electron-builder build --win --mac --linux",
    "pack": "electron-builder --dir"
  },
  "author": "Senior Architect",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.6.8",
    "clipboardy": "2.3.0",
    "electron-log": "^5.1.2",
    "electron-store": "^8.2.0",
    "fs-extra": "^11.2.0",
    "node-notifier": "^10.0.1",
    "node-schedule": "^2.1.1"
  },
  "devDependencies": {
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.autodash.controlpanel",
    "productName": "AutoDash Control Panel",
    "win": {
      "target": "nsis",
      "icon": "src/renderer/assets/icons/icon.ico"
    }
  }
}
